# WordCraft as StarDocs builds it: our fork's "stardocs" branch = upstream tag `base` plus one
# commit per StarDocs change. Bump `commit` after pushing to the fork, then run
# scripts/fetch-upstream.sh (it also regenerates Cargo.toml from upstream's).
repo = "https://github.com/DomeShifter/wordcraft.git"
branch = "stardocs"
commit = "297d5165ec2df41651752a7387f94689e0aa3417"
base = "v0.18.1"
upstream = "https://github.com/storytold/wordcraft.git"
