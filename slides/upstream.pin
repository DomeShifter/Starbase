# DeckCraft as Starbase Slides builds it: our fork's "starslides" branch = upstream tag `base` plus
# one commit per Starbase Slides change. Bump `commit` after pushing to the fork, then run
# scripts/fetch-upstream.sh (it also regenerates Cargo.toml from upstream's).
repo = "https://github.com/DomeShifter/deckcraft.git"
branch = "starslides"
commit = "18249e914b52c828e0c9087132366bb8460bd7f1"
base = "v0.18.1"
upstream = "https://github.com/storytold/deckcraft.git"
