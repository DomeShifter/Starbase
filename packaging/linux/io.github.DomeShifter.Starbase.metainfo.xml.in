<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub) for the whole Starbase package. One
     component, because Flathub has one app ID per package; the three menu entries are listed
     Flathub allows one launchable, so only Starbase Drive (the home screen) is listed; the
     Sheets, Docs and Slides menu entries are still installed and exported (their IDs start with the app
     ID). Releases are written out by hand, newest first, from the root CHANGELOG.md; development
     builds carry no release entry of their own. Checked against Flathub's MetaInfo and quality
     guidelines (packaging/linux/flathub-submission.md). -->
<component type="desktop-application">
  <id>io.github.DomeShifter.Starbase</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Starbase</name>
  <summary>Edit spreadsheets and documents</summary>
  <developer id="io.github.domeshifter">
    <name>DomeShifter</name>
  </developer>
  <description>
    <p>
      Starbase is an open-source office suite: Starbase Sheets for spreadsheets, Starbase Docs for
      documents, Starbase Slides for presentations, and Starbase Drive, a home screen that lists
      your files and folders.
    </p>
    <p>
      Keep your files in a Starbase folder inside Documents, or connect to your own
      Starbase server to share files and edit them together with other people at the same time.
    </p>
    <p>
      Starbase Sheets opens and saves Excel (.xlsx), OpenDocument (.ods) and CSV files. Starbase Docs
      opens and saves Word (.docx), OpenDocument (.odt) and RTF files. Starbase Slides opens and saves
      PowerPoint (.pptx) files.
    </p>
  </description>
  <launchable type="desktop-id">io.github.DomeShifter.Starbase.desktop</launchable>
  <icon type="stock">io.github.DomeShifter.Starbase</icon>
  <url type="homepage">https://github.com/DomeShifter/Starbase</url>
  <url type="bugtracker">https://github.com/DomeShifter/Starbase/issues</url>
  <url type="help">https://github.com/DomeShifter/Starbase#readme</url>
  <url type="vcs-browser">https://github.com/DomeShifter/Starbase</url>
  <url type="contribute">https://github.com/DomeShifter/Starbase/blob/main/starsheets/CONTRIBUTING.md</url>
  <categories>
    <category>Office</category>
    <category>Spreadsheet</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>spreadsheet</keyword>
    <keyword>word processor</keyword>
    <keyword>office</keyword>
    <keyword>xlsx</keyword>
    <keyword>docx</keyword>
  </keywords>
  <!-- Flathub wants image links pinned to a commit or tag, never a branch. Taken from a test
       server with made-up content, light theme (packaging/linux/screenshots/). -->
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/DomeShifter/Starbase/21ddd88894d237c63166830befac78b773eaa340/packaging/linux/screenshots/drive.png</image>
      <caption>Starbase Drive lists your folders, spreadsheets and documents</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/DomeShifter/Starbase/21ddd88894d237c63166830befac78b773eaa340/packaging/linux/screenshots/sheets.png</image>
      <caption>A budget with formulas and currency formats in Starbase Sheets</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/DomeShifter/Starbase/21ddd88894d237c63166830befac78b773eaa340/packaging/linux/screenshots/docs.png</image>
      <caption>Planning notes with headings in Starbase Docs</caption>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9ec5f8</color>
    <color type="primary" scheme_preference="dark">#1e3f73</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>starsheets</binary>
    <binary>stardocs</binary>
    <binary>starslides</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</mediatype>
    <mediatype>application/vnd.ms-excel.sheet.macroEnabled.12</mediatype>
    <mediatype>application/vnd.ms-excel.sheet.binary.macroEnabled.12</mediatype>
    <mediatype>application/vnd.oasis.opendocument.spreadsheet</mediatype>
    <mediatype>text/csv</mediatype>
    <mediatype>text/tab-separated-values</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.presentationml.presentation</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.presentationml.template</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.presentationml.slideshow</mediatype>
  </provides>
  <!-- OARS: no violence, drugs, gambling, ads, purchases or chat with strangers. Sharing and
       comments only reach people on a Starbase server the user chose to connect to. -->
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.2.0" date="2026-11-26">
      <url type="details">https://github.com/DomeShifter/Starbase/blob/v0.2.0/CHANGELOG.md</url>
      <description>
        <p>
          The first release you can install on Linux as a desktop program, still an early preview:
          keep backups of files that matter.
        </p>
        <ul>
          <li>Install from Starbase's own signed Flatpak repository, or download the signed AppImage</li>
          <li>Starbase Slides opens and saves PowerPoint files, next to Sheets and Docs</li>
          <li>Sheets: pivot table editor, alternating colours, Smart Fill, sparklines and pictures in cells</li>
          <li>Docs: make a copy, download in every format, picture toolbar and your own default styles</li>
          <li>Drive: a photo grid with a slideshow, and a new sign-in page and account menu</li>
          <li>Saves to a server that failed are tried again by themselves</li>
          <li>Sharing: a Commenter role, and Sheets pastes keep formulas, formatting and rules between tabs and files</li>
          <li>A Windows installer preview (unsigned) is published alongside</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-25">
      <url type="details">https://github.com/DomeShifter/Starbase/blob/v0.1.0/CHANGELOG.md</url>
      <description>
        <p>
          The first public release, an early preview: it works and is used every day, but expect
          rough edges, and keep backups of files that matter.
        </p>
        <ul>
          <li>Starbase Sheets for spreadsheets, Starbase Docs for documents and Starbase Drive as the home screen</li>
          <li>Opens and saves Excel, Word and OpenDocument files</li>
          <li>Connect to your own Starbase server to share files and edit spreadsheets live with others</li>
          <li>Version history for documents and spreadsheets kept on a server</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
